private void MoveItemsIntoWand(){
        ItemStack wand = inventory.getStackInSlot(27);
        if(wand.getItem() instanceof WandItem wandItem){
            int capacity = wandItem.getCapacity(wand);
            NonNullList<ItemStack> toStore = NonNullList.withSize(capacity, ItemStack.EMPTY);

            for(int i = 0; i < capacity; i++){
                ItemStack stack = inventory.getStackInSlot(i);
                LOGGER.info("1/3. Move Items Into Wand -> stack przed if ->  {}", stack);

                if(!stack.isEmpty()){
                    toStore.set(i, stack.copy());
                    LOGGER.info("2/3. Move Items Into Wand -> stack w if ->  {}", stack);
                }
                inventory.setStackInSlot(i, ItemStack.EMPTY);
            }
            LOGGER.info("3/3. Move Items Into Wand -> wand -> {} , toStore -> {}", wand, toStore);
            if (toStore.stream().anyMatch(stack -> !stack.isEmpty())){
                wandItem.setStoredItems(wand, toStore, this.level);
                playFeedbackSound(level, getBlockPos(), FeedbackType.SUCCESS);
            } else playFeedbackSound(level, getBlockPos(), FeedbackType.FAIL);

        }
    }

    private void MoveItemsIntoBlock(WandItem wandItem, ItemStack wand){
            int capacity = wandItem.getCapacity(wand);
            List<ItemStack> stored = wandItem.getStoredItems(wand, this.level);
            LOGGER.info("1/2. Move Items Into Block -> stored -> {} , capacity -> {}", stored, capacity);

            for(int i = 0; i < capacity; i++){
                ItemStack itemInBlock = inventory.getStackInSlot(i);
                if(itemInBlock == ItemStack.EMPTY){
                    inventory.setStackInSlot(i ,stored.get(i).copy());
                    LOGGER.info("2/2. Move Items Into Block -> stored.copy -> {}", stored.get(i));
                } else{
                    ItemEntity entity = new ItemEntity(level,
                            worldPosition.getX() + 0.5,
                            worldPosition.getY() + 1.0,
                            worldPosition.getZ() + 0.5,
                            stored.get(i).copy());
                    level.addFreshEntity(entity);
                }
                wandItem.clearStoredItems(wand);
            }
        }

    public NonNullList<ItemStack> getStoredItems(ItemStack wand, Level level) {
            int capacity = getCapacity(wand);
            NonNullList<ItemStack> list = NonNullList.withSize(capacity, ItemStack.EMPTY);
            CompoundTag tag = wand.get(ModDataComponents.WAND_ITEMS.get());

            if(tag != null && tag.contains("Items", Tag.TAG_LIST)){
                ListTag itemsTag = tag.getList("Items", Tag.TAG_COMPOUND);
                LOGGER.info("1/3. Get Stored Items -> tag -> {} , wand -> {} , capacity -> {} , list -> {} , itemsTag -> {}", tag, wand, capacity, list, itemsTag);

                for(int i = 0; i < itemsTag.size(); i++){
                    CompoundTag stackTag = itemsTag.getCompound(i);
                    LOGGER.info("logger 1");
                    int slot = stackTag.getInt("Slot");
                    ItemStack stack = ItemStack.parse(level.registryAccess(), stackTag).orElse(ItemStack.EMPTY);
                    LOGGER.info("logger 2");

                    if(!stack.isEmpty() && slot >= 0 && slot < list.size()){
                        LOGGER.info("logger 3");
                        list.set(slot, stack);
                        LOGGER.info("2/3. Get Stored Items -> stackTag - > {} , stack -> {} , list {} -> {} ", stackTag, stack, i, list.get(i));

                    }
                }
            }
            LOGGER.info("3/3. Get Stored items -> lista -> {}" , list);
            return list;
        }


    public void setStoredItems(ItemStack stack, List<ItemStack> items, Level level) {
            int capacity = getCapacity(stack);
            ListTag itemsTag = new ListTag();

            LOGGER.info("1/4. Set Stored Items -> itemsTag ->  {}", itemsTag);
            LOGGER.info("2/4. Set Stored Items -> lista ktura przyszla -> {}", items);
            for(int i = 0; i < capacity; i++){
                ItemStack item = items.get(i);
                if(!item.isEmpty()){
                    CompoundTag itemTag = new CompoundTag();
                    item.save(level.registryAccess(), itemTag);
                    itemTag.putString("id", BuiltInRegistries.ITEM.getKey(item.getItem()).toString());
                    itemTag.putByte("Count", (byte) item.getCount());
                    itemTag.putInt("Slot", i);
                    itemsTag.add(itemTag);

                    LOGGER.info("3/4. Set Stored Items -> itemTag -> {} , itemsTag -> {}",itemTag , itemsTag);
                }

            }

            CompoundTag rootTag = new CompoundTag();
            rootTag.put("Items", itemsTag);

            stack.set(ModDataComponents.WAND_ITEMS.get(), rootTag);

            LOGGER.info("4/4. Set Stored Items -> stack -> {} , rootTag -> {}", stack, rootTag);
        }